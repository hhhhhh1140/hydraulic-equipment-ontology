m:AL-HISTORY-FAULT a m:ConfirmedFault ;
    rdfs:label "液压泵内泄漏"@zh ;
    m:alarm m:AL-HISTORY ;
    m:confirmedAt "2026-11-22T08:00:00+00:00"^^xsd:dateTime ;
