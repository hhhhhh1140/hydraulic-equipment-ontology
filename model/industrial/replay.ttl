m:OBS-BEFORE-NO a sosa:Observation,
        m:QualifiedObservation,
        m:ReplayObservation ;
    rdfs:seeAlso <https://doi.org/10.24432/C5CW21> ;
    prov:wasDerivedFrom uci:Cycle0612-PS1 ;
    sosa:hasFeatureOfInterest m:P-100 ;
    sosa:madeBySensor m:DEMO-HP01-PS1 ;
    sosa:observedProperty m:Pressure ;
    m:expectedUnit "bar"^^xsd:string ;
