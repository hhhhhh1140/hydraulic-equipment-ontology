    m:position m:HP-01 ;
    m:quality "NO_SIGNAL"^^xsd:string ;
    m:rule m:PUMP-REPLAY-1 ;
    m:scenarioTime "2026-11-21T10:00:00+00:00"^^xsd:dateTime ;
    m:status "open"^^xsd:string .

