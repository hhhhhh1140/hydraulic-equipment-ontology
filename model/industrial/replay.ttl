    m:originCycle uci:Cycle0612 ;
    m:position m:HP-01 ;
    m:pumpCode 2 ;
    m:quality "QUALIFIED"^^xsd:string ;
    m:reading 173.0603 ;
    m:reportedUnit "bar"^^xsd:string ;
    m:rowNumber 612 ;
    m:scenarioTime "2026-11-19T12:15:00+00:00"^^xsd:dateTime .

