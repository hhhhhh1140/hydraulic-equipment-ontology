m:AL-BEFORE a m:Alarm ;
    rdfs:label "换装前 · 可处理告警"@zh ;
    m:evidence m:OBS-BEFORE ;
    m:installation m:INSTALL-100 ;
    m:position m:HP-01 ;
    m:quality "QUALIFIED"^^xsd:string ;
    m:rule m:PUMP-REPLAY-1 ;
    m:scenarioTime "2026-11-19T09:00:00+00:00"^^xsd:dateTime ;
    m:status "open"^^xsd:string .

m:AL-MISSING a m:Alarm ;
